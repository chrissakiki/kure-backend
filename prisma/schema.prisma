// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FaqPage {
  MAIN
  ACADEMY
  PACKAGES
}

enum UserRole {
  ADMIN
  USER
}

enum OtpPurpose {
  EMAIL_VERIFICATION
}

// -- Auth --
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([role])
  @@map("users")
}

model OtpChallenge {
  id         String     @id @default(uuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([email, purpose])
  @@map("otp_challenges")
}

// -- FAQ --

// CREATE TABLE "faq_categories" (
//   "id"         TEXT         NOT NULL PRIMARY KEY DEFAULT gen_random_uuid(),
//   "label"      TEXT         NOT NULL,
//   "title"      TEXT         NOT NULL,
//   "sortOrder"  INTEGER      NOT NULL,
//   "isActive"   BOOLEAN      NOT NULL DEFAULT true,
//   "createdAt"  TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
//   "updatedAt"  TIMESTAMP(3) NOT NULL
// );

model FaqCategory {
  id        String   @id @default(uuid())
  page      FaqPage
  label     String
  title     String
  sortOrder Int
  isActive  Boolean  @default(true)
  faqs      Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_categories")
}

// CREATE TABLE "faqs" (
//   "id"          TEXT         NOT NULL PRIMARY KEY DEFAULT gen_random_uuid(),
//   "question"    TEXT         NOT NULL,
//   "answer"      TEXT         NOT NULL,
//   "sortOrder"   INTEGER      NOT NULL,
//   "isActive"    BOOLEAN      NOT NULL DEFAULT true,
//   "categoryId"  TEXT         NOT NULL,
//   "createdAt"   TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
//   "updatedAt"   TIMESTAMP(3) NOT NULL,
//
//   CONSTRAINT "faqs_categoryId_fkey"
//     FOREIGN KEY ("categoryId")
//     REFERENCES "faq_categories"("id")
//     ON DELETE CASCADE
//     ON UPDATE CASCADE
// );

model Faq {
  id         String      @id @default(uuid())
  question   String
  answer     String
  sortOrder  Int
  isActive   Boolean     @default(true)
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("faqs")
}

// -- Testimonials --
model TestimonialCategory {
  id           String        @id @default(uuid())
  label        String
  title        String
  isActive     Boolean       @default(true)
  sortOrder    Int
  testimonials Testimonial[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("testimonial_categories")
}

model Testimonial {
  id         String              @id @default(uuid())
  name       String
  content    String
  subtitle   String
  isActive   Boolean             @default(true)
  sortOrder  Int
  categoryId String
  category   TestimonialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("testimonials")
}

// -- Heroes --

enum SitePage {
  HOME
  SERVICES
  PACKAGES
  GIFT_VOUCHERS
  LOCATIONS
  CORPORATE
  ACADEMY
  ABOUT
  CAREERS
  TESTIMONIALS
  FAQ
  TERMS
  PRIVACY
}

model Hero {
  id                String   @id @default(uuid())
  page              SitePage @unique
  eyebrow           String?
  title             String
  titleAccent       String?
  tagline           String?
  description       String?
  notice            String?
  imageUrl          String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  highlights        String[] @default([])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("heroes")
}

model SectionIntro {
  id          String   @id @default(uuid())
  page        SitePage
  sectionKey  String
  eyebrow     String?
  title       String
  titleAccent String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, sectionKey])
  @@map("section_intros")
}

model SectionOutro {
  id                String   @id @default(uuid())
  page              SitePage @unique
  eyebrow           String?
  title             String
  titleAccent       String?
  description       String?
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("section_outros")
}

// -- Legal pages (Terms, Privacy) --

model LegalDocument {
  id        String   @id @default(uuid())
  page      SitePage @unique
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_documents")
}

// -- Rich HTML content blocks 

model ContentBlock {
  id         String   @id @default(uuid())
  page       SitePage
  sectionKey String
  content    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([page, sectionKey])
  @@map("content_blocks")
}

// -- Milestone 

model MilestoneStat {
  id         String   @id @default(uuid())
  page       SitePage
  sectionKey String
  value      String
  label      String
  sortOrder  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([page, sectionKey, sortOrder])
  @@map("milestone_stats")
}

// -- Shared CMS blocks --

model OfferCard {
  id          String   @id @default(uuid())
  page        SitePage
  sectionKey  String
  name        String
  imageUrl    String?
  subtitle    String?
  badge       String?
  price       String
  priceNote   String?
  perks       String[] @default([])
  ctaLabel    String?
  ctaHref     String?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, sectionKey, sortOrder])
  @@map("offer_cards")
}

model FeatureItem {
  id          String   @id @default(uuid())
  page        SitePage
  sectionKey  String
  title       String
  description String?
  content     String?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, sectionKey, sortOrder])
  @@map("feature_items")
}

model StepItem {
  id          String   @id @default(uuid())
  page        SitePage
  sectionKey  String
  title       String
  description String
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, sectionKey, sortOrder])
  @@map("step_items")
}

enum JobOpeningStatus {
  ACTIVELY_HIRING
  TALENT_POOL
}

model JobOpening {
  id              String           @id @default(uuid())
  title           String
  status          JobOpeningStatus
  employmentTypes String[]         @default([])
  locations       String[]         @default([])
  description     String
  sortOrder       Int              @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("job_openings")
}
